# Navidrome runs natively on the host, so containers reach it through the
# host gateway rather than a compose service name.
NAVIDROME_URL=http://host.docker.internal:4533
NAVIDROME_USER=
NAVIDROME_PASS=

LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=

# How often to re-read Navidrome's starred list, in seconds.
REFRESH_SECONDS=900

# Import list to refresh when the starred set changes. Leave empty to discover
# it automatically (works while exactly one CustomImport list exists).
LIDARR_IMPORTLIST_ID=

# Optional tuning.
# Pause between /artist/lookup calls, in seconds.
# LOOKUP_DELAY_SECONDS=0.5
# Upper bound on the retry backoff for unresolved names, in seconds.
# MAX_BACKOFF_SECONDS=21600

# Discogs, optional. Its catalogue is larger than MusicBrainz's and it carries
# tracklists. Read access needs no OAuth: key and secret go straight in a
# header. Leaving these empty still works, at 25 requests a minute instead of
# 60. Create an application at https://www.discogs.com/settings/developers
DISCOGS_KEY=
DISCOGS_SECRET=

# The address the browser reaches /userscript.js at. Required behind a proxy
# that strips a path prefix — Caddy's handle_path and nginx's location both do —
# because the bridge cannot see the prefix and would emit an @updateURL that
# 404s, which Tampermonkey follows silently.
#   PUBLIC_SCRIPT_URL=https://navidrome.example/ndlb/userscript.js
PUBLIC_SCRIPT_URL=
