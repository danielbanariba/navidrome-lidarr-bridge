# Copy to ../.env and fill in. The bridge reads the same file.

# Where your music already lives. Navidrome reads it; Lidarr writes into it.
MUSIC_DIR=/mnt/Entretenimiento/Musica
# The parent of both the library and the downloads. One root in every container
# is what makes an import a rename instead of a copy.
DATA_DIR=/mnt/Entretenimiento
LIDARR_ROOT_FOLDER=/data/Musica/Lidarr

PUID=1000
PGID=1000
TZ=UTC

NAVIDROME_USER=
NAVIDROME_PASS=
QBITTORRENT_USER=admin
QBITTORRENT_PASS=

# Left blank on a first run: the *arr services mint their own on first start and
# bootstrap.py reads them out of deploy/config/<service>/config.xml.
LIDARR_API_KEY=
PROWLARR_API_KEY=

# The hostname Caddy serves, if you use the caddy profile. Add it to the
# userscript @match list too — the script does not fire on a host it has never
# heard of.
SITE_HOST=navidrome.localhost
